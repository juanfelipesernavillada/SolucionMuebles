<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= categoria.nombre %> | Muebles. </title>
    <link rel="stylesheet" href="/css/output.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        html { scroll-behavior: smooth; }
        .sidebar-transition { transition: transform 0.3s ease-in-out; }
    </style>
</head>
<body class="bg-stone-50 text-stone-700 font-light">

    <!-- ========================================================= -->
    <!-- SIDEBAR -->
    <!-- ========================================================= -->
    <div id="sidebar-overlay" data-action="toggle-sidebar" class="fixed inset-0 bg-black/50 z-50 hidden opacity-0 transition-opacity duration-300"></div>

    <aside id="sidebar" class="fixed top-0 left-0 h-full w-72 bg-white z-[51] shadow-2xl transform -translate-x-full transition-transform duration-300 overflow-y-auto">
        <div class="p-6 border-b flex justify-between items-center">
            <span class="font-bold uppercase tracking-widest text-sm text-stone-600">Explorar Categorías</span>
            <button data-action="toggle-sidebar" class="text-3xl text-stone-400 hover:text-black">&times;</button>
        </div>
        <nav class="p-4 space-y-1">
            <% if (categorias && categorias.length > 0) { %>
                <% categorias.forEach(cat => { %>
                    <a href="/categoria/<%= cat.slug %>" data-action="close-sidebar" class="flex items-center p-3 hover:bg-stone-50 rounded-lg transition font-medium text-stone-700 border-b border-stone-100">
                        <%= cat.nombre %>
                    </a>
                <% }) %>
            <% } %>
            <a href="/" data-action="close-sidebar" class="flex items-center p-3 hover:bg-stone-50 rounded-lg transition font-medium text-stone-700 mt-2">
                <i class="bi bi-grid me-3"></i> Ver Catálogo General
            </a>
        </nav>
    </aside>

    <!-- ========================================================= -->
    <!-- NAVBAR (idéntico a index.ejs) -->
    <!-- ========================================================= -->
    <nav class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-stone-200">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <button data-action="toggle-sidebar" class="p-2 hover:bg-stone-200 rounded-lg transition mr-1">
                <i class="bi bi-list text-4xl text-stone-800"></i>
            </button>
            <h1 class="text-2xl font-bold tracking-widest uppercase text-stone-400">
                Muebles.
            </h1>
            <button data-action="toggle-cart" class="relative p-2 hover:bg-stone-100 rounded-full transition">
                <i class="bi bi-bag text-2xl"></i>
                <span id="cart-count" class="absolute top-0 right-0 bg-orange-800 text-white text-[10px] rounded-full h-5 w-5 flex items-center justify-center font-bold">0</span>
            </button>
        </div>
    </nav>

    <!-- ========================================================= -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ========================================================= -->
    <main class="max-w-7xl mx-auto px-6 py-20">
        <div class="mb-12 border-b border-stone-200 pb-6">
            <h1 class="text-4xl font-serif text-stone-800 uppercase tracking-widest">
                <%= categoria.nombre %>
            </h1>
            <span class="text-stone-400 text-sm"><%= productos.length %> productos</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
            <% productos.forEach(p => { %>
                <article class="group cursor-pointer">
                    <div class="relative overflow-hidden aspect-[3/4] bg-stone-200 mb-4">
                        <a href="/producto/<%= p.product_slug %>" class="block w-full h-full">
                            <img src="<%= p.img %>" alt="<%= p.nombre %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-700">
                        </a>
                        <!-- Botón con data-product-name agregado -->
                        <button data-action="add-to-cart" data-product-id="<%= p.id %>" data-product-name="<%= p.nombre %>" class="absolute bottom-4 right-4 bg-white text-stone-900 p-4 rounded-full shadow-xl opacity-0 group-hover:opacity-100 transition translate-y-2 group-hover:translate-y-0">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                    <h3 class="text-lg mb-1 text-stone-800 font-medium"><%= p.nombre %></h3>
                    <a href="/producto/<%= p.product_slug %>" class="inline-flex items-center gap-2 text-sm text-stone-500 hover:text-stone-900 transition">
                        Ver detalles <i class="bi bi-arrow-right"></i>
                    </a>
                </article>
            <% }) %>
        </div>
    </main>

    <!-- ========================================================= -->
    <!-- CARRITO DRAWER (UNIFICADO) -->
    <!-- ========================================================= -->
    <%- include('partials/drawer') %>

    <!-- ========================================================= -->
    <!-- FOOTER (idéntico a index.ejs) -->
    <!-- ========================================================= -->
    <footer class="bg-stone-900 text-stone-400 py-16 mt-20 border-t-4 border-orange-900">
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-12">
            <div>
                <h4 class="text-white font-bold uppercase tracking-widest mb-6 text-xs">Muebles.</h4>
                <p class="text-sm leading-relaxed">Diseño artesanal colombiano para hogares modernos. Calidad garantizada en cada pieza.</p>
            </div>
            <div>
                <h4 class="text-white font-bold uppercase tracking-widest mb-6 text-xs">Atención al Cliente</h4>
                <ul class="space-y-3 text-sm">
                    <li><i class="bi bi-geo-alt me-2"></i> Calle 123 siempre viva, Ciudad</li>
                    <li><i class="bi bi-geo-alt me-2"></i> Calle 123 siempre viva, Ciudad</li>
                    <li><i class="bi bi-envelope me-2"></i> contacto@ejemplo.com</li>
                    <li><i class="bi bi-whatsapp me-2"></i> +57 300 000 0000</li>
                </ul>
            </div>
            <div>
                <h4 class="text-white font-bold uppercase tracking-widest mb-6 text-xs">Síguenos</h4>
                <div class="flex gap-5 text-xl">
                    <a href="#"></i></a>
                    <a href="#"></i></a>
                    <a href="#"></i></a>
                    <a href="#"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="/js/main.js" defer></script>
</body>
</html>