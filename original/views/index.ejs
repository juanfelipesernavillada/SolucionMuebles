    <div
        class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-12">


        <!-- Información -->

        <div>

            <h4
                class="text-white font-bold uppercase tracking-widest mb-6 text-xs">

                Muebles.

            </h4>

            <p
                class="text-sm leading-relaxed">

                Diseño artesanal colombiano para hogares modernos.
                Calidad garantizada en cada pieza.

            </p>

        </div>


        <!-- Atención -->

        <div>

            <h4
                class="text-white font-bold uppercase tracking-widest mb-6 text-xs">

                Atención al Cliente

            </h4>

            <ul
                class="space-y-3 text-sm">

                <li>
                    <i class="bi bi-geo-alt me-2"></i>
                    Calle 123 siempre viva, Ciudad
                </li>

                <li>
                    <i class="bi bi-geo-alt me-2"></i>
                    Calle 123 siempre viva, Ciudad
                </li>

                <li>
                    <i class="bi bi-envelope me-2"></i>
                    contacto@ejemplo.com
                </li>

                <li>
                    <i class="bi bi-whatsapp me-2"></i>
                    +57 300 000 0000
                </li>

            </ul>

        </div>


        <!-- Redes -->

        <div>

            <h4
                class="text-white font-bold uppercase tracking-widest mb-6 text-xs">

                Síguenos

            </h4>


            <div
                class="flex gap-5 text-xl">

                <a
                    href="#"
                    class="hover:text-orange-500 transition"
                    aria-label="Instagram">

                    <i class="bi bi-instagram"></i>

                </a>


                <a
                    href="#"
                    class="hover:text-orange-500 transition"
                    aria-label="Facebook">

                    <i class="bi bi-facebook"></i>

                </a>


                <a
                    href="#"
                    class="hover:text-orange-500 transition"
                    aria-label="TikTok">

                    <i class="bi bi-tiktok"></i>

                </a>


                <a
                    href="#"
