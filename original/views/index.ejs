<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Muebles. | Tienda Oficial</title>

    <!-- Tailwind CSS compilado -->
    <link rel="stylesheet" href="/css/output.css">

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
    >

    <style>
        html {
            scroll-behavior: smooth;
        }

        .sidebar-transition {
            transition: transform 0.3s ease-in-out;
        }

        .submenu {
            display: none;
        }

        .submenu.active {
            display: block;
        }
    </style>
</head>

<body class="bg-stone-50 text-stone-700 font-light">

<%
    function slug(s) {
        return s.toString()
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
    }
%>


<!-- ========================================================= -->
<!-- SIDEBAR -->
<!-- ========================================================= -->

<div
    id="sidebar-overlay"
    data-action="toggle-sidebar"
    class="fixed inset-0 bg-black/50 z-50 hidden opacity-0 transition-opacity duration-300">
</div>


<aside
    id="sidebar"
    class="fixed top-0 left-0 h-full w-72 bg-white z-[51] shadow-2xl transform -translate-x-full transition-transform duration-300 overflow-y-auto">

    <div class="p-6 border-b flex justify-between items-center">

        <span class="font-bold uppercase tracking-widest text-sm text-stone-600">
            Explorar Categorías
        </span>

        <button
            type="button"
            data-action="toggle-sidebar"
            class="text-3xl text-stone-400 hover:text-black"
            aria-label="Cerrar menú">
            &times;
        </button>

    </div>


    <nav class="p-4 space-y-1">

        <% categorias.forEach(cat => { %>

            <a
                href="#cat-<%= cat.slug %>"
                data-action="close-sidebar"
                class="flex items-center p-3 hover:bg-stone-50 rounded-lg transition font-medium text-stone-700 border-b border-stone-100">

                <%= cat.nombre %>

            </a>

        <% }) %>


        <a
            href="#catalogo"
            data-action="close-sidebar"
            class="flex items-center p-3 hover:bg-stone-50 rounded-lg transition font-medium text-stone-700 mt-2">

            <i class="bi bi-grid me-3"></i>

            Ver Catálogo General

        </a>

    </nav>

</aside>


<!-- ========================================================= -->
<!-- NAVBAR -->
<!-- ========================================================= -->

<nav class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-stone-200">

    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">

        <!-- Botón menú -->
        <button
            type="button"
            data-action="toggle-sidebar"
            class="p-2 hover:bg-stone-200 rounded-lg transition mr-1"
            aria-label="Abrir menú">

            <i class="bi bi-list text-4xl text-stone-800"></i>

        </button>


        <!-- Nombre del negocio -->
        <h1 class="text-2xl font-bold tracking-widest uppercase text-stone-400">
            Muebles.
        </h1>


        <!-- Carrito / Bolsa de cotización -->
        <button
            type="button"
            data-action="toggle-cart"
            class="relative p-2 hover:bg-stone-100 rounded-full transition"
            aria-label="Abrir productos seleccionados">

            <i class="bi bi-bag text-2xl"></i>

            <span
                id="cart-count"
                class="absolute top-0 right-0 bg-orange-800 text-white text-[10px] rounded-full h-5 w-5 flex items-center justify-center font-bold">
                0
            </span>

        </button>

    </div>

</nav>


<!-- ========================================================= -->
<!-- CARRUSEL PRINCIPAL -->
<!-- ========================================================= -->

<section
    id="hero-carousel"
    class="relative w-full h-[70vh] min-h-[500px] overflow-hidden group bg-stone-100">

    <div id="slides-container" class="relative w-full h-full">

        <!-- SLIDE 1: Sala Concha -->
        <div class="slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out opacity-100 z-10">
            <img src="/images/productos/sala-concha/original.webp" alt="Sala Concha" class="w-full h-full object-cover">
            <div class="absolute inset-0 flex items-center justify-center bg-black/30 z-10 px-6">
                <div class="text-center text-white max-w-2xl">
                    <h2 class="text-3xl md:text-5xl font-serif mb-4">Minimalismo para <br> <span class="italic">vivir mejor</span></h2>
                    <p class="text-base md:text-lg mb-8 opacity-90 font-light">Colecciones exclusivas 2026. Calidad artesanal para hogares con alma.</p>
                    <a href="#catalogo" class="inline-block border border-white text-white uppercase tracking-widest text-xs md:text-sm font-medium px-8 py-4 hover:bg-white hover:text-stone-900 transition duration-300">
                        Explorar catálogo
                    </a>
                </div>
            </div>
        </div>

        <!-- SLIDE 2: Sala Set Corona -->
        <div class="slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out opacity-0 z-0">
            <img src="/images/productos/sala-set-corona/original.webp" alt="Sala Set Corona" class="w-full h-full object-cover">
            <div class="absolute inset-0 flex items-center justify-center bg-black/30 z-10 px-6">
                <div class="text-center text-white max-w-2xl">
                    <h2 class="text-3xl md:text-5xl font-serif mb-4">Salas que <br> <span class="italic">unen familias</span></h2>
                    <p class="text-base md:text-lg mb-8 opacity-90 font-light">Descubre nuestra nueva línea de salas con diseño y confort insuperable.</p>
                    <a href="#catalogo" class="inline-block border border-white text-white uppercase tracking-widest text-xs md:text-sm font-medium px-8 py-4 hover:bg-white hover:text-stone-900 transition duration-300">
                        Explorar catálogo
                    </a>
                </div>
            </div>
        </div>

        <!-- SLIDE 3: Sofá Seccional Chaise Longue -->
        <div class="slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out opacity-0 z-0">
            <img src="/images/productos/sofa-seccional-chaise-longue/original.webp" alt="Sofá Seccional Chaise Longue" class="w-full h-full object-cover">
            <div class="absolute inset-0 flex items-center justify-center bg-black/30 z-10 px-6">
                <div class="text-center text-white max-w-2xl">
                    <h2 class="text-3xl md:text-5xl font-serif mb-4">Detalles que <br> <span class="italic">marcan diferencia</span></h2>
                    <p class="text-base md:text-lg mb-8 opacity-90 font-light">Muebles seccionales diseñados para adaptarse a tu estilo de vida.</p>
                    <a href="#catalogo" class="inline-block border border-white text-white uppercase tracking-widest text-xs md:text-sm font-medium px-8 py-4 hover:bg-white hover:text-stone-900 transition duration-300">
                        Explorar catálogo
                    </a>
                </div>
            </div>
        </div>

        <!-- SLIDE 4: Sala Modular con Puff -->
        <div class="slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out opacity-0 z-0">
            <img src="/images/productos/sala-modular-con-puff/original.webp" alt="Sala Modular con Puff" class="w-full h-full object-cover">
            <div class="absolute inset-0 flex items-center justify-center bg-black/30 z-10 px-6">
                <div class="text-center text-white max-w-2xl">
                    <h2 class="text-3xl md:text-5xl font-serif mb-4">Comodidad sin <br> <span class="italic">límites</span></h2>
                    <p class="text-base md:text-lg mb-8 opacity-90 font-light">Sistemas modulares que transforman tus espacios.</p>
                    <a href="#catalogo" class="inline-block border border-white text-white uppercase tracking-widest text-xs md:text-sm font-medium px-8 py-4 hover:bg-white hover:text-stone-900 transition duration-300">
                        Explorar catálogo
                    </a>
                </div>
            </div>
        </div>

        <!-- SLIDE 5: Sofá Cama Click Clack -->
        <div class="slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out opacity-0 z-0">
            <img src="/images/productos/sofa-cama-click-clack/original.webp" alt="Sofá Cama Click Clack" class="w-full h-full object-cover">
            <div class="absolute inset-0 flex items-center justify-center bg-black/30 z-10 px-6">
                <div class="text-center text-white max-w-2xl">
                    <h2 class="text-3xl md:text-5xl font-serif mb-4">Funcionalidad y <br> <span class="italic">diseño</span></h2>
                    <p class="text-base md:text-lg mb-8 opacity-90 font-light">Sofá camas prácticos, elegantes y listos para cualquier ocasión.</p>
                    <a href="#catalogo" class="inline-block border border-white text-white uppercase tracking-widest text-xs md:text-sm font-medium px-8 py-4 hover:bg-white hover:text-stone-900 transition duration-300">
                        Explorar catálogo
                    </a>
                </div>
            </div>
        </div>

    </div>

    <!-- Botón anterior -->
    <button
        type="button"
        data-action="slide"
        data-target="prev"
        class="absolute left-4 top-1/2 -translate-y-1/2 z-20 text-white bg-black/20 hover:bg-black/50 p-3 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 cursor-pointer"
        aria-label="Slide anterior">
        <i class="bi bi-chevron-left text-2xl"></i>
    </button>

    <!-- Botón siguiente -->
    <button
        type="button"
        data-action="slide"
        data-target="next"
        class="absolute right-4 top-1/2 -translate-y-1/2 z-20 text-white bg-black/20 hover:bg-black/50 p-3 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 cursor-pointer"
        aria-label="Slide siguiente">
        <i class="bi bi-chevron-right text-2xl"></i>
    </button>

    <!-- Indicadores -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex space-x-3">
        <button type="button" data-action="slide" data-target="0" class="dot w-3 h-3 rounded-full bg-white transition-colors duration-300" aria-label="Ir al slide 1"></button>
        <button type="button" data-action="slide" data-target="1" class="dot w-3 h-3 rounded-full bg-white/50 hover:bg-white/80 transition-colors duration-300" aria-label="Ir al slide 2"></button>
        <button type="button" data-action="slide" data-target="2" class="dot w-3 h-3 rounded-full bg-white/50 hover:bg-white/80 transition-colors duration-300" aria-label="Ir al slide 3"></button>
        <button type="button" data-action="slide" data-target="3" class="dot w-3 h-3 rounded-full bg-white/50 hover:bg-white/80 transition-colors duration-300" aria-label="Ir al slide 4"></button>
        <button type="button" data-action="slide" data-target="4" class="dot w-3 h-3 rounded-full bg-white/50 hover:bg-white/80 transition-colors duration-300" aria-label="Ir al slide 5"></button>
    </div>

</section>


<!-- ========================================================= -->
<!-- CATÁLOGO DINÁMICO -->
<!-- ========================================================= -->

<main id="catalogo" class="max-w-7xl mx-auto px-6 py-20">

    <%
        const categoriasConProductos = [
            ...new Set(productos.map(p => p.categoria))
        ];

        categoriasConProductos.forEach(cat => {
            const catProductos = productos.filter(p => p.categoria === cat);
            const total = catProductos.length;
            const hasMore = total > 8;

            // Separamos exactamente los 8 primeros para mostrarlos nítidos (2 filas)
            const primerosOcho = catProductos.slice(0, 8);
            
            // Tomamos los siguientes 4 (la tercera fila) para forzar el corte
            const terceraFila = catProductos.slice(8, 12);
    %>

        <section id="cat-<%= slug(cat) %>" class="mb-20 scroll-mt-24">

            <!-- Encabezado de la categoría -->
            <div class="flex items-end justify-between mb-10 border-b border-stone-200 pb-4">
                <div>
                    <h2 class="text-3xl font-serif text-stone-800 uppercase tracking-widest">
                        <%= cat %>
                    </h2>
                    <span class="text-stone-400 text-sm">
                        <%= total %> productos
                    </span>
                </div>
            </div>

            <!-- 1. LAS DOS PRIMERAS FILAS (8 productos intactos y funcionales) -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
                <% primerosOcho.forEach(p => { %>
                    <article class="group cursor-pointer">
                        <div class="relative overflow-hidden aspect-[3/4] bg-stone-200 mb-4">
                            <a href="/producto/<%= p.slug %>" class="block w-full h-full">
                                <img src="<%= p.img %>" alt="<%= p.nombre %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-700">
                            </a>
                            <button type="button" data-action="add-to-cart" data-product-id="<%= p.id %>" class="absolute bottom-4 right-4 bg-white text-stone-900 p-4 rounded-full shadow-xl opacity-0 group-hover:opacity-100 transition translate-y-2 group-hover:translate-y-0" aria-label="Agregar <%= p.nombre %> a productos seleccionados">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <h3 class="text-lg mb-1 text-stone-800 font-medium">
                            <%= p.nombre %>
                        </h3>
                        <a href="/producto/<%= p.slug %>" class="inline-flex items-center gap-2 text-sm text-stone-500 hover:text-stone-900 transition">
                            Ver detalles <i class="bi bi-arrow-right"></i>
                        </a>
                    </article>
                <% }) %>
            </div>

            <!-- 2. TERCERA FILA CORTADA Y DIFUMINADA (Con CSS Nativo Estricto) -->
            <% if (hasMore) { %>
                <div class="mt-6 relative">

                    <!-- Contenedor con altura máxima estricta y máscara de desvanecimiento nativa -->
                    <div style="max-height: 220px; overflow: hidden; -webkit-mask-image: linear-gradient(to bottom, black 30%, transparent 100%); mask-image: linear-gradient(to bottom, black 30%, transparent 100%);">
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 opacity-60 pointer-events-none select-none">
                            <% terceraFila.forEach(p => { %>
                                <article>
                                    <div class="relative overflow-hidden aspect-[3/4] bg-stone-200 mb-4">
                                        <img src="<%= p.img %>" alt="" class="w-full h-full object-cover">
                                    </div>
                                    <h3 class="text-lg mb-1 text-stone-800 font-medium"><%= p.nombre %></h3>
                                </article>
                            <% }) %>
                        </div>

                    </div>

                    <!-- 3. EL ENLACE ALINEADO A LA DERECHA (Puesto justo debajo del corte) -->
                    <div class="flex justify-end -mt-4 relative z-10">
                        <a href="/categoria/<%= slug(cat) %>" class="group inline-flex items-center gap-2 text-sm font-semibold text-stone-700 hover:text-black uppercase tracking-widest transition-colors bg-white px-2 py-1 rounded">
                            VER TODOS LOS PRODUCTOS 
                            <i class="bi bi-arrow-right transform group-hover:translate-x-1 transition-transform"></i>
                        </a>
                    </div>

                </div>
            <% } %>

        </section>

    <% }) %>

</main>

<!-- ========================================================= -->
<!-- CARRITO DRAWER (UNIFICADO) -->
<!-- ========================================================= -->
<%- include('partials/drawer') %>

<!-- ========================================================= -->
<!-- FOOTER -->
<!-- ========================================================= -->

